# העתק לקובץ .env (באותה תיקייה) ומלא. אל תעלה מפתחות אמיתיים ל-git.

# מחרוזת חיבור MongoDB (Atlas וכו')
MONGO_URI=

# מפתח שרת ל-Google Places API (חיפוש טקסט / Nearby).
# חשוב: לא להשתמש במפתח עם "HTTP referrers" — זה רק לדפדפן. מהשרת צריך מפתח עם
# Application restrictions = IP addresses (או None לפיתוח). אחרת: "referer restrictions cannot be used with this API".
# אותו מפתח צריך לאפשר גם את Places API (New) — Text Search: places.googleapis.com
GOOGLE_MAPS_API_KEY={{putkeyhere}}

# אופציונלי — אם מוגדר והשורה למעלה ריקה, הקוד משתמש בו.
# GOOGLE_PLACES_API_KEY={{putkeyhere}}

# Google AI Studio — מפתח ל-Gemini (תכנון חיפוש). מוגדר רק כ-GEMINI_API_KEY (לא משתמש ב-GOOGLE_MAPS_API_KEY).
# https://aistudio.google.com/apikey
# חשוב: קובץ זה הוא backend/.env — הוא מנצח על משתנים זהים ב-beams/.env (שורש הפרויקט) אחרי restart לשרת.
GEMINI_API_KEY={{putkeyhere}}

# אופציונלי — מודל Gemini (ברירת מחדל gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# אמת כדי לקבל ב-meta את אובייקט searchDebug (תוכנית Gemini + סיכום בקשה ל-Google)
# AI_PLACE_SEARCH_DEBUG=true

